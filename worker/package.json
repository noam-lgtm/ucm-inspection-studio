{
  "name": "ucm-inspection-sync-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker: sync storage (D1 + R2) and AI extraction proxy for UCM Inspection Studio.",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute ucm-inspection --remote --file=./schema.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
